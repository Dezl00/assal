generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  phone         String?   @unique
  address       String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  activityLogs  ActivityLog[]
  permissions   String[]  @default([])
  isActive      Boolean   @default(true)
  orderUpdatesEnabled Boolean @default(false) // Customer setting for push notifications
  notifications Notification[]
  pushSubscriptions PushSubscription[]
}

model Widget {
  id          String   @id @default(cuid())
  type        String   // HeroSlider, BannerGrid, FeaturedProducts, etc.
  title       String?
  subtitle    String?
  status      Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  // Visibility
  showDesktop Boolean  @default(true)
  showTablet  Boolean  @default(true)
  showMobile  Boolean  @default(true)
  
  // Styling JSON (Padding, Margin, Width, BgColor, Animation, CssClass)
  settings    Json?    
  
  // Data Source JSON (e.g. { source: "Category", categoryId: "123", sort: "Newest", limit: 10 })
  dataSource  Json?    
  
  // Display Options JSON (Columns, Rows, Spacing, ImageRatio, ShowPrice, etc.)
  display     Json?    

  // Content (Slides for Hero, Banners, etc.)
  items       WidgetContentItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WidgetContentItem {
  id           String  @id @default(cuid())
  widgetId     String
  widget       Widget  @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  
  desktopImage String?
  mobileImage  String?
  title        String?
  subtitle     String?
  buttonText   String?
  buttonUrl    String?
  sortOrder    Int     @default(0)
  status       Boolean @default(true)
  
  // For specific redirects (Brand, Category, Product)
  redirectType String?
  redirectId   String?
  
  // Custom Settings (Alignment, Colors, Button Styles)
  settings     Json?
}

model MediaAsset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  url          String
  format       String
  width        Int?
  height       Int?
  bytes        Int?
  folder       String?
  createdAt    DateTime @default(now())
}

model Department {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  categories  Category[]
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?
  isActive     Boolean    @default(true)
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  
  products     Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  products    Product[] @relation("CollectionProducts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  sku            String?      @unique
  barcode        String?
  description    String?
  price          Float
  discountPrice  Float?
  stock          Int          @default(0)
  isActive       Boolean      @default(true)
  
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  
  collections    Collection[] @relation("CollectionProducts")
  
  images         ProductImage[]
  
  // Product Recommendation overrides (Optional)
  recommendationMode String @default("Automatic") // Automatic, Manual, Disabled
  
  orders         OrderItem[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  productViews   ProductView[]
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String?
  customerPhone String?
  address       String?
  city          String?
  governorate   String?
  status        String      @default("PENDING") // PENDING, PAID, SHIPPED, CANCELLED
  totalAmount   Float
  shippingCost  Float       @default(0)
  discount      Float       @default(0)
  couponCode    String?
  paymentMethod String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  price      Float
}

model Menu {
  id          String     @id @default(cuid())
  name        String     @unique // e.g., 'header-menu', 'footer-menu'
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id          String     @id @default(cuid())
  menuId      String
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label       String
  url         String?
  icon        String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    MenuItem[] @relation("MenuHierarchy")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ThemeConfig {
  id            String   @id @default(cuid()) // We will only use one record, id="default"
  storeName     String   @default("عسل طبيعي")
  storeDescription String?
  logoUrl       String?
  faviconUrl    String?
  primaryColor  String   @default("#000000")
  secondaryColor String  @default("#ffffff")
  borderRadius  String   @default("0px")
  buttonStyle   String   @default("solid") // solid, outline
  
  adminColor    String   @default("#0f172a")
  whatsappNumber String?
  whatsappEnabled Boolean @default(true)
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
  tiktokUrl     String?
  snapchatUrl   String?
  
  backupFrequency String @default("never") // never, daily, 3days, weekly, monthly
  
  // Offers & Shipping
  freeShippingThreshold Float?
  promoPopupEnabled     Boolean @default(false)
  promoPopupDelay       Int     @default(10)
  promoPopupTitle       String?
  promoPopupDescription String?
  promoPopupCode        String?
  
  // Notification Toggles for Admin
  adminOrderNotifications Boolean @default(true)
  adminNewCustomerNotifications Boolean @default(true)
  
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // Create, Update, Delete, Login
  entityType  String   // Product, Widget, etc.
  entityId    String?
  details     Json?
  ipAddress   String?
  browser     String?
  createdAt   DateTime @default(now())
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  mapUrl      String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageVisit {
  id          String   @id @default(cuid())
  path        String
  ipAddress   String?
  userAgent   String?
  country     String?
  city        String?
  createdAt   DateTime @default(now())
}

model ProductView {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  country     String?
  city        String?
  createdAt   DateTime @default(now())
}

model Backup {
  id          String   @id @default(cuid())
  filename    String
  size        Int
  status      String   // COMPLETED, FAILED, PENDING
  createdAt   DateTime @default(now())
}

model Governorate {
  id           String   @id @default(cuid())
  name         String   @unique
  shippingCost Float    @default(0)
  hideCities   Boolean  @default(false)
  isActive     Boolean  @default(true)
  cities       City[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model City {
  id            String      @id @default(cuid())
  name          String
  shippingCost  Float       @default(0)
  isActive      Boolean     @default(true)
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PaymentMethod {
  id           String   @id @default(cuid())
  name         String
  type         String   // COD, ELECTRONIC_WALLET, INSTAPAY
  accountInfo  String?  // Phone number
  paymentLink  String?  // Payment link for Instapay
  instructions String?
  logoUrl      String?  // Logo for payment method
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   // PERCENTAGE, FIXED, FREE_SHIPPING
  value      Float
  maxUses    Int?
  usedCount  Int      @default(0)
  isActive   Boolean  @default(true)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // If null, it is an admin notification
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // e.g. "ORDER_CREATED", "ORDER_SHIPPED", "NEW_CUSTOMER", "ORDER_CANCELLED"
  link      String?  // Link to order or user profile
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?  // If null, it belongs to an admin user session
  user      User?    @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  role      Role?    // Track if this subscription belongs to an admin or customer
  createdAt DateTime @default(now())
}
